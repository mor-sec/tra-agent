        <mxCell id="step-1" value="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1" ><mxGeometry x="140" y="470" width="28" height="28" as="geometry" /></mxCell>
        <mxCell id="step-2" value="2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1" ><mxGeometry x="205" y="340" width="28" height="28" as="geometry" /></mxCell>
        <mxCell id="step-3" value="3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1" ><mxGeometry x="470" y="340" width="28" height="28" as="geometry" /></mxCell>
        <mxCell id="step-4" value="4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1" ><mxGeometry x="706" y="300" width="28" height="28" as="geometry" /></mxCell>
        <mxCell id="step-5" value="5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1" ><mxGeometry x="950" y="580" width="28" height="28" as="geometry" /></mxCell>
        <mxCell id="step-6" value="6" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1" ><mxGeometry x="520" y="500" width="28" height="28" as="geometry" /></mxCell>
        <mxCell id="step-7" value="7" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1" ><mxGeometry x="400" y="305" width="28" height="28" as="geometry" /></mxCell>
        <mxCell id="legend-bg" value="" style="verticalLabelPosition=bottom;verticalAlign=top;html=1;shape=mxgraph.basic.rect;fillColor2=none;strokeWidth=1;size=20;indent=5;fillColor=light-dark(#EDF3FF,#305363);strokeColor=#6c8ebf;" vertex="1" parent="1" ><mxGeometry x="1740" y="30" width="600" height="1030" as="geometry" /></mxCell>
        <mxCell id="legend-container" value="" style="group" vertex="1" parent="1" ><mxGeometry x="1760" y="60" width="560" height="990" as="geometry" /></mxCell>
        <mxCell id="step-1-legend" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="legend-container" ><mxGeometry x="0" y="0" width="550" height="120" as="geometry" /></mxCell>
        <mxCell id="step-1-badge-legend" value="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-1-legend" ><mxGeometry x="0" y="2" width="40" height="38" as="geometry" /></mxCell>
        <mxCell id="step-1-desc-legend" value='&lt;div&gt;&lt;b&gt;Sign in&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style="color: light-dark(rgb(0,0,0), rgb(255,255,255));"&gt;&lt;b&gt;&lt;font style="font-size: 15px;"&gt;-&lt;/font&gt; &lt;/b&gt;Practitioners, risk owners and the CISO sign in to Entra ID. Their app roles and clearance go into the token. G3 needs phishing-resistant MFA from the last 10 minutes.&lt;/span&gt;&lt;/div&gt;' style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-1-legend" ><mxGeometry x="52" y="0" width="498" height="120" as="geometry" /></mxCell>
        <mxCell id="step-2-legend" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="legend-container" ><mxGeometry x="0" y="132" width="550" height="120" as="geometry" /></mxCell>
        <mxCell id="step-2-badge-legend" value="2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-2-legend" ><mxGeometry x="0" y="2" width="40" height="38" as="geometry" /></mxCell>
        <mxCell id="step-2-desc-legend" value="&lt;div&gt;&lt;b&gt;Create a TRA or decide a gate&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;-&lt;/font&gt; &lt;/b&gt;The portal calls the orchestrator agent through the Foundry project endpoint, which is reachable only privately. Foundry's front door uses Authorization for the caller's token, so the user's token travels in x-client-tra-user and the container checks it.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-2-legend" ><mxGeometry x="52" y="0" width="498" height="120" as="geometry" /></mxCell>
        <mxCell id="step-3-legend" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="legend-container" ><mxGeometry x="0" y="264" width="550" height="120" as="geometry" /></mxCell>
        <mxCell id="step-3-badge-legend" value="3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-3-legend" ><mxGeometry x="0" y="2" width="40" height="38" as="geometry" /></mxCell>
        <mxCell id="step-3-desc-legend" value='&lt;div&gt;&lt;b&gt;Delegate to specialists&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style="color: light-dark(rgb(0,0,0), rgb(255,255,255));"&gt;&lt;b&gt;&lt;font style="font-size: 15px;"&gt;-&lt;/font&gt; &lt;/b&gt;The orchestrator calls each specialist agent with Invocations (the payload is the same as A2A), carrying an on-behalf-of token for one audience.&lt;/span&gt;&lt;/div&gt;' style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-3-legend" ><mxGeometry x="52" y="0" width="498" height="120" as="geometry" /></mxCell>
        <mxCell id="step-4-legend" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="legend-container" ><mxGeometry x="0" y="396" width="550" height="120" as="geometry" /></mxCell>
        <mxCell id="step-4-badge-legend" value="4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-4-legend" ><mxGeometry x="0" y="2" width="40" height="38" as="geometry" /></mxCell>
        <mxCell id="step-4-desc-legend" value="&lt;div&gt;&lt;b&gt;Call tools in code&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;-&lt;/font&gt; &lt;/b&gt;The specialists call the two MCP servers. These run as internal Container Apps and accept only the orchestrator's and specialists' client IDs.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-4-legend" ><mxGeometry x="52" y="0" width="498" height="120" as="geometry" /></mxCell>
        <mxCell id="step-5-legend" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="legend-container" ><mxGeometry x="0" y="528" width="550" height="120" as="geometry" /></mxCell>
        <mxCell id="step-5-badge-legend" value="5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-5-legend" ><mxGeometry x="0" y="2" width="40" height="38" as="geometry" /></mxCell>
        <mxCell id="step-5-desc-legend" value='&lt;div&gt;&lt;b&gt;Fetch artefacts&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style="color: light-dark(rgb(0,0,0), rgb(255,255,255));"&gt;&lt;b&gt;&lt;font style="font-size: 15px;"&gt;-&lt;/font&gt; &lt;/b&gt;The artefacts server reads Git and Confluence over HTTPS. Its managed identity reads the Confluence token from Key Vault. It refuses anything unlabelled or PROTECTED.&lt;/span&gt;&lt;/div&gt;' style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-5-legend" ><mxGeometry x="52" y="0" width="498" height="120" as="geometry" /></mxCell>
        <mxCell id="step-6-legend" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="legend-container" ><mxGeometry x="0" y="660" width="550" height="120" as="geometry" /></mxCell>
        <mxCell id="step-6-badge-legend" value="6" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-6-legend" ><mxGeometry x="0" y="2" width="40" height="38" as="geometry" /></mxCell>
        <mxCell id="step-6-desc-legend" value='&lt;div&gt;&lt;b&gt;Draft with a model&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style="color: light-dark(rgb(0,0,0), rgb(255,255,255));"&gt;&lt;b&gt;&lt;font style="font-size: 15px;"&gt;-&lt;/font&gt; &lt;/b&gt;Claude on Foundry is not Australia-resident, so the specialists federate. They exchange an Entra token for short-lived AWS role credentials, then call Claude on Bedrock through the AU profile. GPT, if used, is a regional Standard deployment in Australia East.&lt;/span&gt;&lt;/div&gt;' style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-6-legend" ><mxGeometry x="52" y="0" width="498" height="120" as="geometry" /></mxCell>
        <mxCell id="step-7-legend" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="legend-container" ><mxGeometry x="0" y="792" width="550" height="120" as="geometry" /></mxCell>
        <mxCell id="step-7-badge-legend" value="7" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-7-legend" ><mxGeometry x="0" y="2" width="40" height="38" as="geometry" /></mxCell>
        <mxCell id="step-7-desc-legend" value='&lt;div&gt;&lt;b&gt;Persist state and audit&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style="color: light-dark(rgb(0,0,0), rgb(255,255,255));"&gt;&lt;b&gt;&lt;font style="font-size: 15px;"&gt;-&lt;/font&gt; &lt;/b&gt;The orchestrator writes the TRA state to versioned blob storage. It appends hash-chained audit events to a container with a time-based immutability policy (lock it after the first deploy). Shared-key access is off on both accounts.&lt;/span&gt;&lt;/div&gt;' style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-7-legend" ><mxGeometry x="52" y="0" width="498" height="120" as="geometry" /></mxCell>
        <mxCell id="legend-aux-note" value='&lt;i&gt;&lt;span style="color: light-dark(rgb(0,0,0), rgb(255,255,255));"&gt;Azure services use generic icons with labels. The images come from Container Registry, and logs and traces go to Log Analytics and Application Insights.&lt;/span&gt;&lt;/i&gt;' style="text;html=1;align=left;verticalAlign=top;fontSize=13;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="legend-container" ><mxGeometry x="0" y="924" width="550" height="60" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
