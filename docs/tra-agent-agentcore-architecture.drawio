        <mxCell id="step-3" value="3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1" ><mxGeometry x="470" y="410" width="28" height="28" as="geometry" /></mxCell>
        <mxCell id="step-4" value="4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1" ><mxGeometry x="690" y="490" width="28" height="28" as="geometry" /></mxCell>
        <mxCell id="step-5" value="5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1" ><mxGeometry x="936" y="540" width="28" height="28" as="geometry" /></mxCell>
        <mxCell id="step-6" value="6" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1" ><mxGeometry x="630" y="560" width="28" height="28" as="geometry" /></mxCell>
        <mxCell id="step-7" value="7" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1" ><mxGeometry x="412" y="330" width="28" height="28" as="geometry" /></mxCell>
        <mxCell id="legend-bg" value="" style="verticalLabelPosition=bottom;verticalAlign=top;html=1;shape=mxgraph.basic.rect;fillColor2=none;strokeWidth=1;size=20;indent=5;fillColor=light-dark(#EDF3FF,#305363);strokeColor=#6c8ebf;" vertex="1" parent="1" ><mxGeometry x="1640" y="30" width="650" height="1030" as="geometry" /></mxCell>
        <mxCell id="legend-container" value="" style="group" vertex="1" parent="1" ><mxGeometry x="1660" y="60" width="602" height="990" as="geometry" /></mxCell>
        <mxCell id="step-1-legend" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="legend-container" ><mxGeometry x="0" y="0" width="600" height="110" as="geometry" /></mxCell>
        <mxCell id="step-1-badge-legend" value="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-1-legend" ><mxGeometry x="0" y="2" width="40" height="38" as="geometry" /></mxCell>
        <mxCell id="step-1-desc-legend" value='&lt;div&gt;&lt;b&gt;Sign in&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style="color: light-dark(rgb(0,0,0), rgb(255,255,255));"&gt;&lt;b&gt;&lt;font style="font-size: 15px;"&gt;-&lt;/font&gt; &lt;/b&gt;Practitioners, risk owners and the CISO sign in to Entra ID. Their app roles and clearance go into the token. G3 needs phishing-resistant MFA from the last 10 minutes.&lt;/span&gt;&lt;/div&gt;' style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-1-legend" ><mxGeometry x="52" y="0" width="548" height="110" as="geometry" /></mxCell>
        <mxCell id="step-2-legend" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="legend-container" ><mxGeometry x="0" y="125" width="600" height="110" as="geometry" /></mxCell>
        <mxCell id="step-2-badge-legend" value="2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-2-legend" ><mxGeometry x="0" y="2" width="40" height="38" as="geometry" /></mxCell>
        <mxCell id="step-2-desc-legend" value="&lt;div&gt;&lt;b&gt;Create a TRA or decide a gate&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;-&lt;/font&gt; &lt;/b&gt;The portal calls the orchestrator runtime with the user's JWT. The AgentCore JWT authorizer checks the audience, then the container checks the token again. The orchestrator stops at gates G1, G2 and G3.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-2-legend" ><mxGeometry x="52" y="0" width="548" height="110" as="geometry" /></mxCell>
        <mxCell id="step-3-legend" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="legend-container" ><mxGeometry x="0" y="250" width="600" height="110" as="geometry" /></mxCell>
        <mxCell id="step-3-badge-legend" value="3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-3-legend" ><mxGeometry x="0" y="2" width="40" height="38" as="geometry" /></mxCell>
        <mxCell id="step-3-desc-legend" value='&lt;div&gt;&lt;b&gt;Delegate to specialists&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style="color: light-dark(rgb(0,0,0), rgb(255,255,255));"&gt;&lt;b&gt;&lt;font style="font-size: 15px;"&gt;-&lt;/font&gt; &lt;/b&gt;For each stage, the orchestrator calls a specialist over A2A: intake, system modeller, threat analyst, control mapper, risk assessor, quality critic. Each call carries an on-behalf-of token for exactly one audience.&lt;/span&gt;&lt;/div&gt;' style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-3-legend" ><mxGeometry x="52" y="0" width="548" height="110" as="geometry" /></mxCell>
        <mxCell id="step-4-legend" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="legend-container" ><mxGeometry x="0" y="375" width="600" height="110" as="geometry" /></mxCell>
        <mxCell id="step-4-badge-legend" value="4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-4-legend" ><mxGeometry x="0" y="2" width="40" height="38" as="geometry" /></mxCell>
        <mxCell id="step-4-desc-legend" value='&lt;div&gt;&lt;b&gt;Call tools in code&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style="color: light-dark(rgb(0,0,0), rgb(255,255,255));"&gt;&lt;b&gt;&lt;font style="font-size: 15px;"&gt;-&lt;/font&gt; &lt;/b&gt;The specialists call the MCP servers from code; the model never picks a tool. The reference server holds the threat library, controls and ATT&amp;CK/ATLAS/ISM. The artefacts server reads design documents.&lt;/span&gt;&lt;/div&gt;' style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-4-legend" ><mxGeometry x="52" y="0" width="548" height="110" as="geometry" /></mxCell>
        <mxCell id="step-5-legend" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="legend-container" ><mxGeometry x="0" y="500" width="600" height="110" as="geometry" /></mxCell>
        <mxCell id="step-5-badge-legend" value="5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-5-legend" ><mxGeometry x="0" y="2" width="40" height="38" as="geometry" /></mxCell>
        <mxCell id="step-5-desc-legend" value='&lt;div&gt;&lt;b&gt;Fetch artefacts&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style="color: light-dark(rgb(0,0,0), rgb(255,255,255));"&gt;&lt;b&gt;&lt;font style="font-size: 15px;"&gt;-&lt;/font&gt; &lt;/b&gt;The artefacts server reads Git and Confluence through the NAT gateway, using a Confluence token from Secrets Manager. It refuses anything unlabelled or PROTECTED.&lt;/span&gt;&lt;/div&gt;' style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-5-legend" ><mxGeometry x="52" y="0" width="548" height="110" as="geometry" /></mxCell>
        <mxCell id="step-6-legend" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="legend-container" ><mxGeometry x="0" y="625" width="600" height="110" as="geometry" /></mxCell>
        <mxCell id="step-6-badge-legend" value="6" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-6-legend" ><mxGeometry x="0" y="2" width="40" height="38" as="geometry" /></mxCell>
        <mxCell id="step-6-desc-legend" value='&lt;div&gt;&lt;b&gt;Draft with Claude&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style="color: light-dark(rgb(0,0,0), rgb(255,255,255));"&gt;&lt;b&gt;&lt;font style="font-size: 15px;"&gt;-&lt;/font&gt; &lt;/b&gt;The specialists call Claude on Bedrock through the bedrock-runtime interface endpoint, using the AU inference profile (Sydney and Melbourne only). Code computes the risk ratings, not the model.&lt;/span&gt;&lt;/div&gt;' style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-6-legend" ><mxGeometry x="52" y="0" width="548" height="110" as="geometry" /></mxCell>
        <mxCell id="step-7-legend" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="legend-container" ><mxGeometry x="0" y="750" width="600" height="110" as="geometry" /></mxCell>
        <mxCell id="step-7-badge-legend" value="7" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-7-legend" ><mxGeometry x="0" y="2" width="40" height="38" as="geometry" /></mxCell>
        <mxCell id="step-7-desc-legend" value='&lt;div&gt;&lt;b&gt;Persist state and audit&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style="color: light-dark(rgb(0,0,0), rgb(255,255,255));"&gt;&lt;b&gt;&lt;font style="font-size: 15px;"&gt;-&lt;/font&gt; &lt;/b&gt;The orchestrator writes the TRA state to a versioned S3 bucket. It appends hash-chained audit events to an Object Lock bucket in compliance mode, which nobody can delete. Both buckets are encrypted with the KMS key.&lt;/span&gt;&lt;/div&gt;' style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-7-legend" ><mxGeometry x="52" y="0" width="548" height="110" as="geometry" /></mxCell>
        <mxCell id="legend-aux-note" value='&lt;i&gt;&lt;span style="color: light-dark(rgb(0,0,0), rgb(255,255,255));"&gt;Auxiliary: CloudWatch keeps the VPC flow logs and X-Ray traces every runtime. Each of the nine runtimes has its own execution role with only the permissions it needs.&lt;/span&gt;&lt;/i&gt;' style="text;html=1;align=left;verticalAlign=top;fontSize=13;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="legend-container" ><mxGeometry x="0" y="875" width="600" height="60" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
